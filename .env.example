# Required
CORE_API_URL=http://127.0.0.1:18080
CORE_SIGNING_SECRET=replace-with-at-least-32-characters
FEISHU_APP_ID=cli_test_app
FEISHU_APP_SECRET=replace-me
FEISHU_BOT_OPEN_ID=ou_test_bot
FEISHU_TENANT_KEY=tenant_test

# Optional: declares this adapter the deployment's sole principal-delivery consumer.
# Do not enable alongside another principal surface (e.g. a Slack adapter).
# FEISHU_CLAIM_PRINCIPAL_DELIVERIES=1

# Optional runtime tuning (defaults shown; container defaults set HEALTH_HOST=0.0.0.0)
# HEALTH_HOST=127.0.0.1
# HEALTH_PORT=3000
# LOG_LEVEL=info
# FEISHU_DELIVERY_CLAIM_MS=30000
# FEISHU_DELIVERY_POLL_MS=1000
# FEISHU_APPROVAL_POLL_MS=1000
# CORE_REQUEST_TIMEOUT_MS=10000
# FEISHU_SHUTDOWN_TIMEOUT_MS=15000
