{
  "name": "@luw2007/qm-feishu",
  "version": "0.1.0",
  "description": "Independent Feishu/Lark message surface for QM",
  "type": "module",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luw2007/qm-feishu.git"
  },
  "bugs": {
    "url": "https://github.com/luw2007/qm-feishu/issues"
  },
  "homepage": "https://github.com/luw2007/qm-feishu#readme",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "start": "node dist/main.js",
    "setup": "node dist/setup-main.js",
    "build": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "docs:check": "node scripts/check-docs.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test 'test/**/*.test.ts'",
    "test:coverage": "node --import tsx --experimental-test-coverage --test 'test/**/*.test.ts'",
    "test:qm-contract": "node --import tsx --test test/qm/contract.integration.test.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.72.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "tsx": "4.23.12",
    "typescript": "6.0.2",
    "typescript-eslint": "8.66.0"
  },
  "qmCompatibility": {
    "repository": "yc-software/qm",
    "revision": "7f2c916"
  }
}
